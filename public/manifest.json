{
  "name": "Archivum",
  "short_name": "Archivum",
  "description": "Your Personal Library",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#06060A",
  "theme_color": "#06060A",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/plain": [".txt"],
        "application/epub+zip": [".epub"]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
